<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sentirum.Agent.Providers.AnthropicCompatible</RootNamespace>
    <AssemblyName>Sentirum.Agent.Providers.AnthropicCompatible</AssemblyName>
    <Description>Anthropic-compatible provider for the Sentirum Agent SDK. Targets any endpoint that speaks the Anthropic Messages API: Bedrock proxies, Z.AI, custom Anthropic gateways.</Description>
    <PackageId>Sentirum.Agent.Providers.AnthropicCompatible</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentirum.Agent.Abstractions\Sentirum.Agent.Abstractions.csproj" />
    <ProjectReference Include="..\Sentirum.Agent.Core\Sentirum.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

</Project>
