<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sentirum.Agent.Sessions.Tree</RootNamespace>
    <AssemblyName>Sentirum.Agent.Sessions.Tree</AssemblyName>
